# P03 LC-01 5.2.2/5.2.3: native raw fields; no rule evaluation.
set ModuleType = "Verification Script";
set OutputType = "VS";
set InputType = "VS";
set DecoderDesc = "P03 dllp raw fields";
set Visited = 0;
set Known = 0;
set Emitted = 0;
set Mismatches = 0;
set Count_ACK = 0;
set Count_NAK = 0;
set Count_INIT_FC1_P = 0;
set Count_INIT_FC1_NP = 0;
set Count_INIT_FC1_CPL = 0;
set Count_INIT_FC2_P = 0;
set Count_INIT_FC2_NP = 0;
set Count_INIT_FC2_CPL = 0;
set Count_UPDATE_FC_P = 0;
set Count_UPDATE_FC_NP = 0;
set Count_UPDATE_FC_CPL = 0;
%include "VSTools.inc"
NativeField(v)
{
    if (v == null) return "{\"state\":\"unknown\",\"value\":null}";
    return FormatEx("{\"state\":\"available\",\"value\":%d}", v);
}
OnStartScript()
{
    ScriptForDisplayOnly();
    EnableOutput();
    SendAllChannels();
    SendLevelOnly(_PACKET);
    SendTraceEventOnly(_PKT_DLLP);
    SendDllpType(_ANY_TYPE);
}
ProcessEvent()
{
    Visited++;
    if (in.Level != _PACKET || in.TraceEvent != _PKT_DLLP) Mismatches++;
    if (in.DLLPType == DLLP_TYPE_ACK)
    {
        Known++;
        Count_ACK++;
        if (Count_ACK <= 8)
        {
        f_AckNak_SeqNum = NativeField(in.AckNak_SeqNum);
        f_VC_ID = "{\"state\":\"not_applicable\",\"value\":null}";
        f_HdrFC = "{\"state\":\"not_applicable\",\"value\":null}";
        f_DataFC = "{\"state\":\"not_applicable\",\"value\":null}";
        f_HdrScale = "{\"state\":\"not_applicable\",\"value\":null}";
