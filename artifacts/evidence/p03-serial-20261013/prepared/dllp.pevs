OnFinishScript()
{
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_ACK, Count_ACK));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_NAK, Count_NAK));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC1_P, Count_INIT_FC1_P));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC1_NP, Count_INIT_FC1_NP));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC1_CPL, Count_INIT_FC1_CPL));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC2_P, Count_INIT_FC2_P));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC2_NP, Count_INIT_FC2_NP));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_INIT_FC2_CPL, Count_INIT_FC2_CPL));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_UPDATE_FC_P, Count_UPDATE_FC_P));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_UPDATE_FC_NP, Count_UPDATE_FC_NP));
    ReportText(FormatEx("{\"kind\":\"p03-count\",\"native_type\":%d,\"visited\":%d}", DLLP_TYPE_UPDATE_FC_CPL, Count_UPDATE_FC_CPL));
    ReportText(FormatEx("{\"kind\":\"p03-end\",\"visited\":%d,\"known\":%d,\"emitted\":%d,\"mismatches\":%d,\"native_level\":%d}", Visited,Known,Emitted,Mismatches,_PACKET));
}
