# P03 LC-01 5.2.2/5.2.3: native raw fields; no rule evaluation.
set ModuleType = "Verification Script";
set OutputType = "VS";
set InputType = "VS";
set DecoderDesc = "P03 tlp raw fields";
set Visited = 0;
set Known = 0;
set Emitted = 0;
set Mismatches = 0;
