# D1 bounded spike: first five TLP records, not full-trace extraction.
set ModuleType = "Verification Script";
set OutputType = "VS";
set InputType = "VS";
set DecoderDesc = "PCIe P0-D1 first five TLP projections - spike-v1";

%include "VSTools.inc"
set Emitted = 0;

OnStartScript()
{
    ScriptForDisplayOnly();
    ReportText("PCIE_D1_TLP_SPIKE_V1 cap=5 time=vendor_display_text");
    SendAllChannels();
    SendTraceEventOnly(_PKT_TLP);
    SendTlpType(_ANY_TYPE);
    Emitted = 0;
}

ProcessEvent()
{
    ReportText(FormatEx("PCIE_D1_TLP|%u|%s|%s|%s|0x%X|%d",
        in.Index, TimeToText(in.Time), GetEventName(), GetChannelName(),
        in.TLPType, in.LinkWidth));
    Emitted++;
    if (Emitted >= 5)
    {
        ScriptDone();
    }
    return Complete();
}
