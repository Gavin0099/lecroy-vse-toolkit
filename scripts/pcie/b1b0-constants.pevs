# PCIe-B1b step 0: print the numeric values of VSE engine constants used to decode B1a/B1b records.
# The values are engine built-ins and are not defined in VS_constants.inc or VSTools.inc.
# Only constant names that appear in the installed VSE manual or vendor example scripts are used.
set ModuleType = "Verification Script";
set OutputType = "VS";
set InputType = "VS";
set DecoderDesc = "PCIe B1b-0 VSE constant value probe - v1";

%include "VSTools.inc"
set EndSent = 0;

C(name, value)
{
    ReportText(FormatEx("PCIE_B1B0_CONST|%s=%d", name, value));
}

OnStartScript()
{
    ScriptForDisplayOnly();
    ReportText("PCIE_B1B0_CONSTANTS_V1");
    C("_PKT_TLP", _PKT_TLP);
    C("_PKT_DLLP", _PKT_DLLP);
    C("_PKT_ORDERED_SET", _PKT_ORDERED_SET);
    C("_PKT_LINK_CONDITION", _PKT_LINK_CONDITION);
    C("_PKT_EIE_EVENT", _PKT_EIE_EVENT);
    C("_PKT_INVALID", _PKT_INVALID);
    C("_CHANNEL_1", _CHANNEL_1);
    C("_CHANNEL_2", _CHANNEL_2);
    C("_SPEED_UNDEFINED", _SPEED_UNDEFINED);
    C("_LINK_WIDTH_UNDEFINED", _LINK_WIDTH_UNDEFINED);
    C("LINK_CONDITION_LINK_DOWN", LINK_CONDITION_LINK_DOWN);
    C("LINK_CONDITION_LINK_UP", LINK_CONDITION_LINK_UP);
    C("LINK_CONDITION_LINK_CLKREQ_UP", LINK_CONDITION_LINK_CLKREQ_UP);
    C("LINK_CONDITION_LINK_CLKREQ_DOWN", LINK_CONDITION_LINK_CLKREQ_DOWN);
    C("LTSSM_NO_STATE", LTSSM_NO_STATE);
    C("LTSSM_STATE_UNDEFINED", LTSSM_STATE_UNDEFINED);
    C("LTSSM_STATE_DETECT", LTSSM_STATE_DETECT);
    C("LTSSM_STATE_POLLING", LTSSM_STATE_POLLING);
    C("LTSSM_STATE_CONFIG", LTSSM_STATE_CONFIG);
    C("LTSSM_STATE_L0", LTSSM_STATE_L0);
    C("LTSSM_STATE_RECOVERY", LTSSM_STATE_RECOVERY);
    C("LTSSM_STATE_HOT_RESET", LTSSM_STATE_HOT_RESET);
    C("LTSSM_STATE_DISABLED", LTSSM_STATE_DISABLED);
    C("LTSSM_STATE_LOOP_BACK", LTSSM_STATE_LOOP_BACK);
    C("LTSSM_STATE_L0S", LTSSM_STATE_L0S);
    C("LTSSM_STATE_L1", LTSSM_STATE_L1);
    C("LTSSM_STATE_L2", LTSSM_STATE_L2);
    C("LTSSM_STATE_RECOVERY_RCVRLOCK", LTSSM_STATE_RECOVERY_RCVRLOCK);
    C("LTSSM_STATE_RECOVERY_RCVRCFG", LTSSM_STATE_RECOVERY_RCVRCFG);
    C("LTSSM_STATE_RECOVERY_RCVRIDL", LTSSM_STATE_RECOVERY_RCVRIDL);
    C("LTSSM_STATE_RECOVERY_RCVREQL", LTSSM_STATE_RECOVERY_RCVREQL);
    C("LTSSM_STATE_RECOVERY_RCVRSPD", LTSSM_STATE_RECOVERY_RCVRSPD);
    C("LTSSM_STATE_CFG_LINKWIDTH_STRT", LTSSM_STATE_CFG_LINKWIDTH_STRT);
    C("LTSSM_STATE_CFG_LINKWIDTH_ACPT", LTSSM_STATE_CFG_LINKWIDTH_ACPT);
    C("LTSSM_STATE_CFG_LANENUM_WAIT_ACPT", LTSSM_STATE_CFG_LANENUM_WAIT_ACPT);
    C("LTSSM_STATE_CFG_COMPLETE", LTSSM_STATE_CFG_COMPLETE);
    C("LTSSM_STATE_CFG_IDLE", LTSSM_STATE_CFG_IDLE);
    C("LTSSM_STATE_RECOVERY_RCVREQL_0", LTSSM_STATE_RECOVERY_RCVREQL_0);
    C("LTSSM_STATE_RECOVERY_RCVREQL_1", LTSSM_STATE_RECOVERY_RCVREQL_1);
    C("LTSSM_STATE_RECOVERY_RCVREQL_2", LTSSM_STATE_RECOVERY_RCVREQL_2);
    C("LTSSM_STATE_RECOVERY_RCVREQL_3", LTSSM_STATE_RECOVERY_RCVREQL_3);
    C("LTSSM_STATE_L1_1_OR_L1_2", LTSSM_STATE_L1_1_OR_L1_2);
    C("LTSSM_STATE_POLLING_ACTIVE", LTSSM_STATE_POLLING_ACTIVE);
    C("LTSSM_STATE_POLLING_COMPLIANCE", LTSSM_STATE_POLLING_COMPLIANCE);
    C("LTSSM_STATE_POLLING_CONFIGURATION", LTSSM_STATE_POLLING_CONFIGURATION);
    C("LTSSM_STATE_POLLING_SPEED", LTSSM_STATE_POLLING_SPEED);
    C("LTSSM_STATE_LOOP_BACK_ENTRY", LTSSM_STATE_LOOP_BACK_ENTRY);
    C("LTSSM_STATE_LOOP_BACK_ACTIVE", LTSSM_STATE_LOOP_BACK_ACTIVE);
    C("LTSSM_STATE_LOOP_BACK_EXIT", LTSSM_STATE_LOOP_BACK_EXIT);
    C("LTSSM_STATE_L0_L0P", LTSSM_STATE_L0_L0P);
    C("LTSSM_STATE_L0_L0P_UP", LTSSM_STATE_L0_L0P_UP);
    C("LTSSM_STATE_L0_L0P_DOWN", LTSSM_STATE_L0_L0P_DOWN);
    SendAllChannels();
    SendTraceEventOnly(_PKT_LINK_CONDITION);
    EndSent = 0;
}

ProcessEvent()
{
    return Complete();
}

OnFinishScript()
{
    if (EndSent == 0)
    {
        ReportText("PCIE_B1B0_END|reason=trace_end");
        EndSent = 1;
    }
}
