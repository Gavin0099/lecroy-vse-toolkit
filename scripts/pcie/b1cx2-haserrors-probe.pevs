        if (Flag(in.InvalidEncoding) == 1)
        {
            anyflag = 1;
            flags += "InvalidEncoding,";
            if (r == 1)
            {
                R1_InvalidEncoding++;
            }
            else if (r == 2)
            {
                R2_InvalidEncoding++;
            }
            else
            {
                R3_InvalidEncoding++;
            }
            if (c == 1)
            {
                C1_InvalidEncoding++;
            }
            else if (c == 2)
            {
                C2_InvalidEncoding++;
            }
            else
            {
                C3_InvalidEncoding++;
            }
        }
        if (Flag(in.RsvdField) == 1)
        {
            anyflag = 1;
            flags += "RsvdField,";
            if (r == 1)
            {
                R1_RsvdField++;
            }
            else if (r == 2)
            {
                R2_RsvdField++;
            }
            else
            {
                R3_RsvdField++;
            }
            if (c == 1)
            {
                C1_RsvdField++;
            }
            else if (c == 2)
            {
                C2_RsvdField++;
            }
            else
            {
                C3_RsvdField++;
            }
        }
        if (Flag(in.ErrorRsvdFld) == 1)
        {
            anyflag = 1;
            flags += "ErrorRsvdFld,";
            if (r == 1)
            {
                R1_ErrorRsvdFld++;
            }
            else if (r == 2)
            {
                R2_ErrorRsvdFld++;
            }
            else
            {
                R3_ErrorRsvdFld++;
            }
            if (c == 1)
            {
                C1_ErrorRsvdFld++;
            }
            else if (c == 2)
            {
                C2_ErrorRsvdFld++;
            }
            else
            {
                C3_ErrorRsvdFld++;
            }
        }
        if (Flag(in.HasIdleErrors) == 1)
        {
            anyflag = 1;
            flags += "HasIdleErrors,";
            if (r == 1)
            {
                R1_HasIdleErrors++;
            }
            else if (r == 2)
            {
                R2_HasIdleErrors++;
            }
            else
            {
                R3_HasIdleErrors++;
            }
            if (c == 1)
            {
                C1_HasIdleErrors++;
            }
            else if (c == 2)
            {
                C2_HasIdleErrors++;
            }
            else
            {
                C3_HasIdleErrors++;
            }
        }
        if (Flag(in.IdleErrorDisparity) == 1)
        {
            anyflag = 1;
            flags += "IdleErrorDisparity,";
            if (r == 1)
            {
                R1_IdleErrorDisparity++;
            }
            else if (r == 2)
            {
                R2_IdleErrorDisparity++;
            }
            else
            {
                R3_IdleErrorDisparity++;
            }
            if (c == 1)
            {
                C1_IdleErrorDisparity++;
            }
            else if (c == 2)
            {
                C2_IdleErrorDisparity++;
            }
            else
            {
                C3_IdleErrorDisparity++;
            }
        }
        if (Flag(in.IdleErrorSymbol) == 1)
        {
            anyflag = 1;
            flags += "IdleErrorSymbol,";
            if (r == 1)
            {
                R1_IdleErrorSymbol++;
            }
            else if (r == 2)
            {
                R2_IdleErrorSymbol++;
            }
            else
            {
                R3_IdleErrorSymbol++;
            }
            if (c == 1)
            {
                C1_IdleErrorSymbol++;
            }
            else if (c == 2)
            {
                C2_IdleErrorSymbol++;
            }
            else
            {
                C3_IdleErrorSymbol++;
            }
        }
        if (Flag(in.IdleErrorSkip) == 1)
        {
            anyflag = 1;
            flags += "IdleErrorSkip,";
            if (r == 1)
            {
                R1_IdleErrorSkip++;
            }
            else if (r == 2)
            {
                R2_IdleErrorSkip++;
            }
            else
            {
                R3_IdleErrorSkip++;
            }
            if (c == 1)
            {
                C1_IdleErrorSkip++;
            }
            else if (c == 2)
            {
                C2_IdleErrorSkip++;
            }
            else
            {
                C3_IdleErrorSkip++;
            }
        }
        if (Flag(in.IdleErrorData) == 1)
        {
            anyflag = 1;
            flags += "IdleErrorData,";
            if (r == 1)
            {
                R1_IdleErrorData++;
            }
            else if (r == 2)
            {
                R2_IdleErrorData++;
            }
            else
            {
                R3_IdleErrorData++;
            }
            if (c == 1)
            {
                C1_IdleErrorData++;
            }
            else if (c == 2)
            {
                C2_IdleErrorData++;
            }
            else
            {
                C3_IdleErrorData++;
            }
        }
        if (Flag(in.FCError) == 1)
        {
            anyflag = 1;
            flags += "FCError,";
            if (r == 1)
            {
                R1_FCError++;
            }
            else if (r == 2)
            {
                R2_FCError++;
            }
            else
            {
                R3_FCError++;
            }
            if (c == 1)
            {
                C1_FCError++;
            }
            else if (c == 2)
            {
                C2_FCError++;
            }
            else
            {
                C3_FCError++;
            }
        }
        HasErr++;
        if (event == _PKT_TLP)
        {
            HeTlp++;
        }
        else if (event == _PKT_DLLP)
        {
            HeDllp++;
        }
        else if (event == _PKT_ORDERED_SET)
        {
            HeOs++;
        }
        else
        {
            HeOther++;
        }
        if (anyflag == 0)
        {
            Unexplained++;
            flags = "NONE";
        }
    }
    un = 0;
    if (he == 1 && anyflag == 0)
    {
        un = 1;
    }
    if (r == 1)
    {
        R1_E++;
        R1_T1 += ts1;
        R1_T2 += ts2;
        R1_H += he;
        R1_U += un;
    }
    if (r == 2)
    {
        R2_E++;
        R2_T1 += ts1;
        R2_T2 += ts2;
        R2_H += he;
        R2_U += un;
    }
    if (r == 3)
    {
        R3_E++;
        R3_T1 += ts1;
        R3_T2 += ts2;
        R3_H += he;
        R3_U += un;
    }
    if (c == 1)
    {
        C1_E++;
        C1_T1 += ts1;
        C1_T2 += ts2;
        C1_H += he;
        C1_U += un;
    }
    if (c == 2)
    {
        C2_E++;
        C2_T1 += ts1;
        C2_T2 += ts2;
        C2_H += he;
        C2_U += un;
    }
    if (c == 3)
    {
        C3_E++;
        C3_T1 += ts1;
        C3_T2 += ts2;
        C3_H += he;
        C3_U += un;
    }
    if (r == 1 && c == 1)
    {
        X11_E++;
        X11_T1 += ts1;
        X11_H += he;
    }
    if (r == 1 && c == 2)
    {
        X12_E++;
        X12_T1 += ts1;
        X12_H += he;
    }
    if (r == 1 && c == 3)
    {
        X13_E++;
        X13_T1 += ts1;
        X13_H += he;
    }
    if (r == 2 && c == 1)
    {
        X21_E++;
        X21_T1 += ts1;
        X21_H += he;
    }
    if (r == 2 && c == 2)
    {
        X22_E++;
        X22_T1 += ts1;
        X22_H += he;
    }
    if (r == 2 && c == 3)
    {
        X23_E++;
        X23_T1 += ts1;
        X23_H += he;
    }
    if (r == 3 && c == 1)
    {
        X31_E++;
        X31_T1 += ts1;
        X31_H += he;
    }
    if (r == 3 && c == 2)
    {
        X32_E++;
        X32_T1 += ts1;
        X32_H += he;
    }
    if (r == 3 && c == 3)
    {
        X33_E++;
        X33_T1 += ts1;
        X33_H += he;
    }
    if (he == 1)
    {
        state = "NA";
        ltssm = in.LtssmState;
        if (ltssm != null)
        {
            state = FormatEx("%u.%u", ltssm[0], ltssm[1]);
        }
        if (r == 1 && S1 < SAMPLE_CAP)
        {
            S1++;
            ReportText(FormatEx("PCIE_B1CX2_SAMPLE|%u|%s|%s|%u|%u|%u|%s|%s|%s", idx, TimeToText(in.Time), GetChannelName(), c, r, event, ordset, state, flags));
        }
        if (r == 2 && S2 < SAMPLE_CAP)
        {
            S2++;
            ReportText(FormatEx("PCIE_B1CX2_SAMPLE|%u|%s|%s|%u|%u|%u|%s|%s|%s", idx, TimeToText(in.Time), GetChannelName(), c, r, event, ordset, state, flags));
        }
        if (r == 3 && S3 < SAMPLE_CAP)
        {
            S3++;
            ReportText(FormatEx("PCIE_B1CX2_SAMPLE|%u|%s|%s|%u|%u|%u|%s|%s|%s", idx, TimeToText(in.Time), GetChannelName(), c, r, event, ordset, state, flags));
        }
    }
    return Complete();
}

