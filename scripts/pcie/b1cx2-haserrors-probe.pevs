Flag(v)
{
    if (v != null)
    {
        if (v != 0)
        {
            return 1;
        }
    }
    return 0;
}

OnStartScript()
{
    ScriptForDisplayOnly();
    ReportText(FormatEx("PCIE_B1CX2_HASERRORS_V1 start=%u end=%u r1_end=%u r2_end=%u cap=%u", WIN_START, WIN_END, R1_END, R2_END, SAMPLE_CAP));
    SendAllChannels();
    SendTraceEventOnly(_PKT_TLP);
    SendTraceEvent(_PKT_DLLP);
    SendTraceEvent(_PKT_ORDERED_SET);
    SendTraceEvent(_PKT_LINK_CONDITION);
    SendTraceEvent(_PKT_EIE_EVENT);
    SendTlpType(_ANY_TYPE);
    SendDllpType(_ANY_TYPE);
    SendLtssm();
    EndSent = 0;
}

ProcessEvent()
{
    idx = in.Index;
    if (idx < WIN_START || idx > WIN_END)
    {
        return Complete();
    }
    r = 3;
    if (idx <= R1_END)
    {
        r = 1;
    }
    else if (idx <= R2_END)
    {
        r = 2;
    }
    c = 3;
    if (in.Channel == _CHANNEL_1)
    {
        c = 1;
    }
    else if (in.Channel == _CHANNEL_2)
    {
        c = 2;
    }
    event = in.TraceEvent;
    ts1 = 0;
    ts2 = 0;
    ordset = "NA";
    if (event == _PKT_ORDERED_SET)
    {
        ot = in.OrderedSetType;
        ordset = FormatEx("%u", ot);
        if (ot == ORDSET_TYPE_TS1 || ot == ORDSET_TYPE_TS1_MOD)
        {
            ts1 = 1;
        }
        if (ot == ORDSET_TYPE_TS2 || ot == ORDSET_TYPE_TS2_MOD)
        {
            ts2 = 1;
        }
    }
    Events++;
    he = Flag(in.HasErrors);
    if (in.ErrorDisparity != null)
