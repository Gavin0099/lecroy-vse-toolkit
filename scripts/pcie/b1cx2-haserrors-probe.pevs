# PCIe-B1c-x2 HasErrors subtype probe v1 (generated from a fixed flag list; edit the list, not the lines).
# Inside the B1b window only. Ranges: R1 225041-1096917 (Recovery and link-condition phases), R2 1096918-1479759
# (Downstream Polling phase), R3 1479760-1484414 (after the 1.312 sec gap). Channels: C1 = _CHANNEL_1, C2 = _CHANNEL_2,
# C3 = any other. For every candidate error member from the VSE manual it counts presence (non-null) over all events and
# set (non-zero) over HasErrors events per range and channel. Descriptive only; no rule.
set ModuleType = "Verification Script";
set OutputType = "VS";
set InputType = "VS";
set DecoderDesc = "PCIe B1c-x2 HasErrors subtype probe - v1";

